app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# ── GoOuts additions, 6 August 2026 ──────────────────────────────
#
# NEVER COMMIT THESE. Unlike a Firebase API key, none of them can be
# rotated without breaking every existing install or handing over
# full database access.

# Android signing
*.jks
*.keystore
key.properties
android/key.properties

# Service accounts — full admin access to Firestore
*serviceAccount*.json
*service-account*.json
*-firebase-adminsdk-*.json

# Apple signing
*.p12
*.mobileprovision
*.cer
ios/Runner/GoogleService-Info.plist.bak

# Environment
.env
.env.*
*.secret

# NOTE: firebase_options.dart, google-services.json and
# GoogleService-Info.plist ARE committed deliberately. Firebase
# client config is compiled into the app binary and is not secret.
# Codemagic needs them present to build.
