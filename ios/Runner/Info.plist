<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  ── PERMISSION STRINGS. NOT OPTIONAL ON iOS. ───────────────────────────

	  ADDED 6 August 2026 after the app hard-crashed on the first TestFlight
	  build, the moment "Capture selfie" was tapped during KYC.

	  iOS does not ask, warn or log. If an app touches the camera and
	  Info.plist has no NSCameraUsageDescription, the system TERMINATES the
	  process immediately. To the user it looks like the app vanished, and
	  there is nothing in Crashlytics that names the cause.

	  This file was generated by `flutter create` and had NO usage
	  descriptions at all, while the registration screens copied from
	  driver_app expect a camera and a photo library. driver_app has these;
	  this app did not, and nothing in the build or the analyzer could have
	  caught it — only running it on a device.

	  Wording matters too: App Review rejects vague strings. Each one says
	  what the app does with the data, not merely that it wants access.
	-->
	<key>NSCameraUsageDescription</key>
	<string>GoOuts Host uses the camera to take the identity selfie and photograph the documents needed to verify you as a host.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>GoOuts Host needs access to your photos so you can upload identity documents and pictures of your property.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>GoOuts Host may save a photo to your library while you are uploading documents.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>GoOuts Host uses Face ID to keep your host account secure.</string>

	<!--
	  ── EXPORT COMPLIANCE, DECLARED ONCE INSTEAD OF EVERY BUILD ─────────────

	  ADDED 7 August 2026. Build 4 and build 5 both stalled in TestFlight at
	  "Missing Compliance" because this is asked PER BUILD, not per app. Left
	  unset, someone has to open App Store Connect and answer the same question
	  before every single release — and a build nobody answers for simply never
	  reaches a tester, with no notification that anything is wrong.

	  Apple's own dialog points at this key as the way to bypass it.

	  false = the app uses only the encryption built into iOS. GoOuts Host
	  talks to Firebase over HTTPS/TLS and implements no cryptography of its
	  own: no custom algorithms, no bundled crypto library. That is the
	  exemption in US EAR 740.17(b), and it is the same answer Mian selected
	  by hand for build 4 ("None of the algorithms mentioned above") — this
	  records that decision rather than making a new one.

	  ⚠ If the app ever ships its own encryption — an encrypted local database,
	  a custom protocol, bundled OpenSSL — this must be revisited. It is a
	  declaration to a US export regime, not a build setting.
	-->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>

	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>GoOuts Host</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>GoOuts Host</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<!--
	  ADDED 6 August 2026. Required for Firebase Phone Auth, not for
	  notifications — this app sends none of its own.

	  Firebase verifies the app by sending a SILENT push before the SMS goes
	  out. remote-notification is what allows iOS to wake the app to receive
	  it. Without this the silent push is dropped, Firebase falls back to a
	  reCAPTCHA web view, and if that also cannot complete the OTP never
	  arrives — with nothing useful in the logs.

	  driver_app lost roughly twenty builds to this exact omission.
	-->
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<!--
	  The REVERSED_CLIENT_ID from GoogleService-Info.plist, registered as a
	  custom URL scheme.

	  This is the OTHER half of phone auth, and it is the half that is easy to
	  miss because nothing about it mentions phone numbers. When the silent
	  APNs push does not arrive — simulator, notifications denied, poor
	  network — Firebase falls back to a reCAPTCHA web view. The web view
	  finishes by opening this scheme to hand control back to the app. Without
	  it the user completes the reCAPTCHA and then sits on a screen that never
	  moves.

	  Must match REVERSED_CLIENT_ID exactly. If Firebase ever reissues the iOS
	  OAuth client, both change together.
	-->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.289872853637-t9dd60rkgm1dugr9vdqt2ubgslh0gi3l</string>
			</array>
		</dict>
	</array>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
