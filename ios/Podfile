# GoOuts Host — iOS pods.
#
# ── WHY THIS FILE EXISTS ─────────────────────────────────────────────────
#
# 13 August 2026. The iOS build went red the moment google_mlkit_face_detection
# was added.
#
# THE CAUSE: this app had NO Podfile at all. It had never had one — it was not
# in git and nothing had needed it, because Flutter generates a default at
# build time when one is missing. That default ships the platform line
# COMMENTED OUT:
#
#     # platform :ios, '12.0'
#
# so CocoaPods falls back to iOS 12 for every pod target. Xcode was building
# the app itself at 15.0 (IPHONEOS_DEPLOYMENT_TARGET in project.pbxproj), so
# nothing ever disagreed — until a pod arrived with a real floor.
#
# ML Kit requires iOS 15.5. CocoaPods resolved against 12, found nothing
# satisfying it, and stopped:
#
#     [!] CocoaPods could not find compatible versions for pod
#         "google_mlkit_commons"
#     ... they required a higher minimum deployment target.
#
# ── ⚠ 15.5, NOT 15.0 ─────────────────────────────────────────────────────
#
# The first fix here set 15.0 and failed again, because the two ML Kit pods
# do not agree with each other:
#
#     GoogleMLKit/FaceDetection   15.0
#     google_mlkit_commons        15.5   <- the binding constraint
#
# 15.0 clears the visible one and stops at the second. Flutter's own error
# names the real floor, and it is 15.5. driver_app and goouts_app were both
# pinned at 15.0 and would have failed identically on their next build — all
# three are now 15.5.
#
# Cost to users is nil: every device that can run iOS 15.0 can run 15.8.
#
# ── ⚠ DO NOT DELETE THIS FILE ────────────────────────────────────────────
#
# It looks like generated scaffolding and it is not. Removing it does not fall
# back to something sensible — it falls back to iOS 12 and breaks the build,
# with an error that points at ML Kit rather than at the missing file.
platform :ios, '15.5'

ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig and running flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      # 15.5 on every pod, not just the app. A pod left at the CocoaPods
      # default will still fail ML Kit's version check even with the platform
      # line above set, because flutter_additional_ios_build_settings can
      # lower individual targets back down.
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.5'

      # Force Swift 5 mode — prevents Swift 6 strict-concurrency crashes in
      # Firebase iOS SDK 11.x (libswift_Concurrency preconditionFailure).
      # Copied from driver_app, where that crash was diagnosed the hard way.
      config.build_settings['SWIFT_VERSION'] = '5'
    end
  end
end
